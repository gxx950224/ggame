{
  "name": "@ggame/backpack",
  "version": "1.0.1",
  "description": "DSH 背包：魔兽世界风格物品栏、袋子管理、货币统计与全会话 token 费用记账（DeepSeek 官方动态定价，含峰谷计价）。",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/gxx950224/ggame.git",
    "directory": "packages/backpack"
  },
  "homepage": "https://github.com/gxx950224/ggame/tree/main/packages/backpack",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./pricing": "./lib/pricing.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "scripts",
    "icons",
    "tests",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node tests/pricing.test.mjs",
    "check": "node --check lib/index.js && node --check lib/client.js && node --check lib/pricing.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1",
    "react": "^18.2.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "backpack",
    "inventory",
    "wow",
    "token-cost",
    "usage-tracking"
  ],
  "license": "MIT"
}
